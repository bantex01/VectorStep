# ---------------------------------------------------------------------------
# Container deployment (Docker / Kubernetes)
# ---------------------------------------------------------------------------
# The defaults below assume a bare checkout, with paths relative to the
# process's working directory. In a container, everything writable lives
# under a single /data volume (see service/Dockerfile and deploy/k8s/).
# Override the equivalent keys like this:
#
#   database: {url: "sqlite+aiosqlite:////data/db/runs.db"}   # four slashes = absolute path
#   pipeline_config_dir: /data/pipelines     # or a ConfigMap mount — operator's choice
#   step_library_dir: /data/steps
#   artifacts: {dir: /data/artifacts}
#   logging: {dir: /data/logs}
# ---------------------------------------------------------------------------

server:
  host: 0.0.0.0
  port: 8000

pipeline_config_dir: ./pipelines
step_library_dir: ./steps

database:
  url: sqlite+aiosqlite:///./runs.db
  # Postgres (recommended for production — see README §Database):
  # url: postgresql+asyncpg://user:password@localhost:5432/vectorstep
  # auto_migrate: true   # run `alembic upgrade head` automatically on boot.
  #                      # Set false to control migrations yourself (DBA-run
  #                      # deployments): startup then fails fast if the schema
  #                      # is behind head instead of migrating it for you. See
  #                      # README §Database.

executors:
  openclaw:
    url: ws://127.0.0.1:18789/rpc   # OpenClaw Gateway WebSocket URL
    # identity_dir: ~/.openclaw/identity  # optional — defaults to ~/.openclaw/identity
    #
    # OpenClaw authenticates using Ed25519 device-signature auth. The identity files
    # (device.json and device-auth.json) are created automatically by OpenClaw when
    # it is installed and run on this machine.
    #
    # If OpenClaw is running on a DIFFERENT machine:
    #   1. Copy ~/.openclaw/identity/ from the OpenClaw machine to this machine
    #      (or mount it as a secret in Kubernetes)
    #   2. Set identity_dir to the path where you copied the files
    #   3. On the OpenClaw machine, run: openclaw devices list
    #      to confirm the device is approved on the remote gateway
    #
    # If identity files are missing at startup, VectorStep will log a warning and the
    # openclaw executor will be registered — but any step using it will fail until
    # the files are in place.

  gateway:
    url: ws://localhost:18780/rpc     # VectorStep Gateway WebSocket URL
    token: ${VECTORSTEP_GATEWAY_TOKEN}     # Bearer token; empty string disables auth for local dev
    rest_url: http://localhost:18780 # VectorStep Gateway REST base URL (used by Agents UI)

notifications:
  telegram:
    bot_token: ${TELEGRAM_BOT_TOKEN}
    chat_id: ${TELEGRAM_CHAT_ID}

# Human-in-the-loop approval routing for `executor: human` steps — see README
# §"human — Human-in-the-Loop". Routes each run to a channel based on its `team`
# (resolved from the auth token that triggered it — see §3b), so different teams
# can use different tools without forking pipelines.
#
# Omit this whole block entirely to keep pre-existing behaviour: every `human` step
# falls back to the single Telegram bot configured under notifications.telegram above.
#
# IMPORTANT: that fallback is a `telegram`-only special case (it reads notifications.telegram
# above when no nested `telegram:` block is given). `slack` and `msteams` have no equivalent
# fallback — a `default:` (or `teams.<name>:`) entry using either of those channels MUST
# include its own nested `slack:`/`msteams:` credentials block, exactly like a team entry does.
# Writing `default: {channel: slack}` alone will raise "missing bot_token/channel_id" at
# runtime the first time a `human` step falls through to it.
# human_approval:
#   # Reachable by whoever will click a Teams approval link (see the msteams channel
#   # below) — NOT localhost unless every approver is on this same machine.
#   ui_base_url: https://vectorstep.internal.example.com
#
#   default:                     # used when a run's team has no entry under `teams` below
#     channel: telegram          # telegram | slack | msteams — telegram can omit the nested
#                                 # block below and it'll use notifications.telegram above;
#                                 # slack/msteams must supply their nested block here too.
#     # telegram:                # optional — only needed to override notifications.telegram
#     #   bot_token: ${TELEGRAM_BOT_TOKEN}
#     #   chat_id: ${TELEGRAM_CHAT_ID}
#
#   teams:
#     team-a:
#       channel: slack
#       slack:
#         bot_token: ${SLACK_BOT_TOKEN_TEAMA}   # xoxb-... — needs chat:write scope
#         app_token: ${SLACK_APP_TOKEN_TEAMA}   # xapp-... — Socket Mode, no public endpoint needed
#         channel_id: C0123456
#     team-b:
#       channel: msteams
#       msteams:
#         # Power Automate "Post to a channel when a webhook request is received" flow URL.
#         # Posts a one-way notification linking to /ui/approvals/{token} — real interactive
#         # Teams cards would need a public Bot Framework callback endpoint, which this
#         # deployment doesn't expose.
#         webhook_url: ${TEAMS_WEBHOOK_URL_TEAMB}
#     team-c:
#       channel: telegram         # falls through to notifications.telegram's bot/chat above

logging:
  level: INFO
  dir: ./logs   # omit to disable file logging (stdout only)
                # creates service.log (app logs) and access.log (HTTP) — rotating, 10 MB x 5

artifacts:
  dir: ./artifacts      # omit this block entirely to disable artifact storage
  retention_days: 7     # artifact directories older than this are removed daily at 02:00

dedup:
  enabled: true          # omit this block (or set false) to disable dedup entirely
  window_seconds: 300    # suppress duplicate webhooks (same pipeline+fingerprint) within this window
                          # — always suppresses while a matching run is still "running",
                          # regardless of this value. Override per-pipeline via trigger.dedup
                          # (see README §3a).

concurrency:
  max_runs: 10   # maximum simultaneous pipeline executions. POST /webhook returns 429
                  # when this limit is reached. Raise for high-volume deployments;
                  # lower to protect LLM spend on constrained hardware.

durability:
  # Service-wide default for durable.max_resume_age_seconds — only takes effect for a
  # pipeline whose `durable:` block doesn't set its own value. Opt-in is per pipeline
  # (`durable: true` in the pipeline YAML); this block has no effect on a pipeline that
  # isn't durable. See docs: Operations > Durability & resume.
  max_resume_age_seconds: 3600   # a run down longer than this is marked interrupted, not resumed

auth:
  # Per-team tokens — see README §3b. Each team's token both authenticates
  # POST /webhook and resolves the `team` attribution recorded on every run
  # it triggers, for the vectorstep_pipeline_tokens_total metric and GET /runs?team=.
  # Generate each token with `openssl rand -hex 24` — a plain shared secret,
  # no issuance endpoint. Resolve via ${ENV_VAR} or write directly into
  # config.yaml (it's gitignored either way).
  # teams:
  #   - name: payments
  #     token: ${VECTORSTEP_WEBHOOK_TOKEN_PAYMENTS}
  #   - name: platform
  #     token: ${VECTORSTEP_WEBHOOK_TOKEN_PLATFORM}
  token: ${VECTORSTEP_WEBHOOK_TOKEN}   # Legacy single-token form — used if `teams` above is unset.
                                  # Every run's team is then unattributed (None). If both
                                  # `teams` and `token` are set, `teams` wins.
                                  # Omit this whole block (or leave blank) to run unauthenticated —
                                  # fine on a private VPN, but set this before exposing the
                                  # port more broadly. Alertmanager sends its token via
                                  # http_config.authorization.credentials in the webhook
                                  # receiver config — route different teams' alerts through
                                  # different receivers with different tokens to use `teams` above.

# Cost accounting (README §Cost accounting) — omit this whole block to run fully
# unpriced (every step's cost stays NULL, every money surface shows "unpriced").
# No prices are bundled — real `cost` is always computed from the `models:` table
# below, which the operator owns and is responsible for keeping current.
# pricing:
#   currency: USD                  # display label only — no FX conversion anywhere
#   models:
#     # example — verify against your provider's current pricing before relying on this
#     - match: {provider: anthropic, model: "claude-sonnet-4-6"}
#       input_per_mtok: 3.00        # currency units per 1,000,000 input tokens
#       output_per_mtok: 15.00
#     - match: {provider: anthropic, model: "claude-haiku"}   # prefix match on the model string
#       input_per_mtok: 1.00
#       output_per_mtok: 5.00
#     - match: {provider: openrouter}                          # provider-only fallback (no model key)
#       input_per_mtok: 2.00
#       output_per_mtok: 8.00
#   team_budgets:                  # optional — advisory only, never blocks a run
#     payments: 500                # currency units per calendar month, UTC
#     platform: 1000
#   live_pricing:                  # optional — best-effort APPROXIMATE cost for
#                                   # unpriced steps, fetched from OpenRouter's public
#                                   # catalog. Never the real `cost` column, never
#                                   # persisted, always shown labeled/colored as an
#                                   # estimate — see README's live/approximate pricing
#                                   # subsection. Off by default.
#     enabled: true
#     refresh_interval_seconds: 3600

replay:
  # Explicit allowlist of "executor:agent" identities a replay batch is allowed to
  # run — see docs: Operations > Replay / shadow evaluation. A replay re-runs real agent calls
  # against live tools (Grafana, Jira, etc.), so only list an agent here once
  # you've verified it makes no side-effecting tool calls. Unset/empty means
  # replay is off entirely — POST /steps/{name}/replay 403s pointing back here.
  safe_agents:
    - "gateway:sre-investigation"
    - "openclaw:incident-triage"
