server:
  host: 0.0.0.0
  port: 8000

pipeline_config_dir: ./pipelines
step_library_dir: ./steps

database:
  url: sqlite+aiosqlite:///./runs.db
  # Postgres (recommended for production — see README §Database):
  # url: postgresql+asyncpg://user:password@localhost:5432/pork

executors:
  openclaw:
    url: ws://127.0.0.1:18789/rpc   # OpenClaw Gateway WebSocket URL
    # identity_dir: ~/.openclaw/identity  # optional — defaults to ~/.openclaw/identity
    #
    # OpenClaw authenticates using Ed25519 device-signature auth. The identity files
    # (device.json and device-auth.json) are created automatically by OpenClaw when
    # it is installed and run on this machine.
    #
    # If OpenClaw is running on a DIFFERENT machine:
    #   1. Copy ~/.openclaw/identity/ from the OpenClaw machine to this machine
    #      (or mount it as a secret in Kubernetes)
    #   2. Set identity_dir to the path where you copied the files
    #   3. On the OpenClaw machine, run: openclaw devices list
    #      to confirm the device is approved on the remote gateway
    #
    # If identity files are missing at startup, P-Ork will log a warning and the
    # openclaw executor will be registered — but any step using it will fail until
    # the files are in place.

  gateway:
    url: ws://localhost:18780/ws     # P-Ork Gateway WebSocket URL
    token: ${PORK_GATEWAY_TOKEN}     # Bearer token; empty string disables auth for local dev
    rest_url: http://localhost:18780 # P-Ork Gateway REST base URL (used by Agents UI)

notifications:
  telegram:
    bot_token: ${TELEGRAM_BOT_TOKEN}
    chat_id: ${TELEGRAM_CHAT_ID}

logging:
  level: INFO
  dir: ./logs   # omit to disable file logging (stdout only)
                # creates service.log (app logs) and access.log (HTTP) — rotating, 10 MB x 5

artifacts:
  dir: ./artifacts      # omit this block entirely to disable artifact storage
  retention_days: 7     # artifact directories older than this are removed daily at 02:00

dedup:
  enabled: true          # omit this block (or set false) to disable dedup entirely
  window_seconds: 300    # suppress duplicate webhooks (same pipeline+fingerprint) within this window
                          # — always suppresses while a matching run is still "running",
                          # regardless of this value. Override per-pipeline via trigger.dedup
                          # (see README §3a).

concurrency:
  max_runs: 10   # maximum simultaneous pipeline executions. POST /webhook returns 429
                  # when this limit is reached. Raise for high-volume deployments;
                  # lower to protect LLM spend on constrained hardware.

auth:
  # Per-team tokens — see README §3b. Each team's token both authenticates
  # POST /webhook and resolves the `team` attribution recorded on every run
  # it triggers, for the pork_pipeline_tokens_total metric and GET /runs?team=.
  # Generate each token with `openssl rand -hex 24` — a plain shared secret,
  # no issuance endpoint. Resolve via ${ENV_VAR} or write directly into
  # config.yaml (it's gitignored either way).
  # teams:
  #   - name: payments
  #     token: ${PORK_WEBHOOK_TOKEN_PAYMENTS}
  #   - name: platform
  #     token: ${PORK_WEBHOOK_TOKEN_PLATFORM}
  token: ${PORK_WEBHOOK_TOKEN}   # Legacy single-token form — used if `teams` above is unset.
                                  # Every run's team is then unattributed (None). If both
                                  # `teams` and `token` are set, `teams` wins.
                                  # Omit this whole block (or leave blank) to run unauthenticated —
                                  # fine on a private VPN, but set this before exposing the
                                  # port more broadly. Alertmanager sends its token via
                                  # http_config.authorization.credentials in the webhook
                                  # receiver config — route different teams' alerts through
                                  # different receivers with different tokens to use `teams` above.
