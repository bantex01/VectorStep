# Copy to .env in this directory before `docker compose up`.

# Anthropic API key used by the Gateway's LLM provider (see compose/gateway-config.yaml).
ANTHROPIC_API_KEY=

# Bearer token VectorStep uses to authenticate to the Gateway's WebSocket/REST API.
# Leave blank for the first `docker compose up` — the Gateway generates its own
# operator token on first run. Read it, put it here, then restart the vectorstep
# service. See the "First run" section in README.md for the exact steps.
VECTORSTEP_GATEWAY_TOKEN=
