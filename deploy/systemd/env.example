# Copy to /etc/vectorstep/vectorstep/env (mode 640, owner root:vectorstep) — see install.md.
# These feed the ${VAR} placeholders in /etc/vectorstep/vectorstep/config.yaml
# (see ../../samples/config.yaml.example for where each is used).

VECTORSTEP_GATEWAY_TOKEN=

# Per-team webhook auth (auth.teams in config.yaml) — one var per team you configure:
# VECTORSTEP_WEBHOOK_TOKEN_PAYMENTS=
# VECTORSTEP_WEBHOOK_TOKEN_PLATFORM=
# Legacy single-token form (auth.token) — used only if auth.teams is unset:
VECTORSTEP_WEBHOOK_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Human-in-the-loop approval channels (human_approval in config.yaml), if used:
# SLACK_BOT_TOKEN_TEAMA=
# SLACK_APP_TOKEN_TEAMA=
# TEAMS_WEBHOOK_URL_TEAMB=
